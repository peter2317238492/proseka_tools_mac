<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ProsekaTools.Avalonia.Views.MysekaiView">
  <Grid Margin="8" ColumnDefinitions="*,2*">
    <ScrollViewer Grid.Column="0">
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Text="解密 (apidecrypt)" Classes="sectiontitle" />

          <TextBlock Text="地区 (region)" />
          <ComboBox x:Name="RegionCombo" Width="160" SelectedIndex="0">
            <ComboBoxItem Content="jp" />
            <ComboBoxItem Content="tw" />
            <ComboBoxItem Content="en" />
            <ComboBoxItem Content="kr" />
            <ComboBoxItem Content="cn" />
          </ComboBox>

          <CheckBox x:Name="UseLatestCheckBox" IsChecked="True" Content="使用最新的 mysekai 捕获" />

          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="ChooseFileButton" Content="选择文件" />
            <TextBox x:Name="SelectedFileTextBox" Width="320" IsReadOnly="True" Watermark="未选择文件" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="StartDecryptButton" Content="开始解密" Classes="accent" />
            <Button x:Name="LoadLatestJsonButton" Content="载入最新 JSON" />
            <Button x:Name="SelfCheckButton" Content="自检" />
          </StackPanel>

          <TextBlock x:Name="StatusText" TextWrapping="Wrap" />

          <StackPanel Classes="panel" Spacing="6" Margin="0,10,0,0">
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="收获唱片" />
            <ListBox x:Name="MusicRecordsList" Height="260">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="Auto,*" Margin="0,6">
                    <Border Width="56" Height="56" Margin="0,0,10,0" CornerRadius="4" Background="#20808080">
                      <Image Source="{Binding JacketImage}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4">
                      <TextBlock TextWrapping="Wrap" Text="{Binding Info}" />
                      <TextBlock Text="{Binding MetaUrl}" FontSize="11" Classes="subtle" />
                      <TextBlock Text="{Binding LoadStatus}" FontSize="10" Classes="subtle" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </StackPanel>
      </Border>
    </ScrollViewer>

    <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="12,0,0,0">
      <Border Classes="card" Margin="0,0,0,10">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <ComboBox x:Name="MapSelectCombo" Width="220" />
          <CheckBox x:Name="ShowIconsCheckBox" IsChecked="True" Content="显示图标" />
          <Button x:Name="ZoomInButton" Content="+" Width="32" />
          <Button x:Name="ZoomOutButton" Content="-" Width="32" />
          <Button x:Name="ResetZoomButton" Content="重置" Width="60" />
        </StackPanel>
      </Border>

      <Border Grid.Row="1" Classes="panel">
        <ScrollViewer x:Name="MapScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <Grid x:Name="MapZoomContainer">
            <Grid>
              <Image x:Name="MapImage" Stretch="None" />
              <Canvas x:Name="MapCanvas" IsHitTestVisible="False" />
            </Grid>
          </Grid>
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</UserControl>
